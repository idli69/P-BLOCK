{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$deviceId": {
        ".read": "auth != null && (auth.uid === $deviceId || data.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $deviceId",
        "commands": {
          ".read": "auth != null && (auth.uid === $deviceId || data.parent().child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $deviceId || data.parent().child('admins').child(auth.uid).val() === true)"
        },
        "custom_blocks": {
          ".read": "auth != null && (auth.uid === $deviceId || data.parent().child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $deviceId || data.parent().child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "pending_codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('device_uid').val() === auth.uid || newData.child('claimed_by').val() === auth.uid)"
      }
    },
    "admins": {
      "$adminUid": {
        ".read": "auth != null && auth.uid === $adminUid",
        ".write": "auth != null && auth.uid === $adminUid",
        "devices": {
          "$deviceId": {
            ".write": "auth != null && auth.uid === $deviceId"
          }
        }
      }
    }
  }
}